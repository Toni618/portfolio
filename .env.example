# Copy this file to .env.local and change the values:
#   cp .env.example .env.local

# Password for /admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Any long random string (generate one: openssl rand -hex 32)
AUTH_SECRET=change-me-to-a-long-random-string

# Local development: leave these two lines commented. A file database (local.db) is created automatically.
# Production (Vercel): create a free database at turso.tech and fill these in.
# DATABASE_URL=libsql://your-db-name-your-user.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token
